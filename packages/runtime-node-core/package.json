    "@arduano/agent-multiplex-storage-sqlite": "0.1.0",
    "@trpc/server": "11.18.0",
    "@types/node": "26.4.0",
    "@types/ws": "8.18.1",
    "@xterm/addon-serialize": "0.14.0",
