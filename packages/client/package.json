{
  "name": "@arduano/agent-multiplex-client",
  "version": "0.2.4-hotfix.1",
  "description": "Browser-safe HTTP and WebSocket clients, command helpers, and cursor utilities for Agent Multiplex.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arduano/agent-multiplex.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/arduano/agent-multiplex#readme",
  "bugs": {
    "url": "https://github.com/arduano/agent-multiplex/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@arduano/agent-multiplex-control-node-core": "0.2.4-hotfix.1",
    "@arduano/agent-multiplex-protocol": "0.2.4-hotfix.1",
    "@noble/hashes": "2.0.1",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "@types/ws": "8.18.1",
    "zod": "4.1.5"
  }
}
