{
  "name": "@arduano/agent-multiplex",
  "version": "0.8.0-alpha.0",
  "description": "Typed native-agent Hosts, gateways and retained clients.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "npm@11.17.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./storage": {
      "node": {
        "types": "./dist/storage/index.d.ts",
        "import": "./dist/storage/index.js"
      },
      "default": null
    },
    "./runtime": {
      "node": {
        "types": "./dist/runtime/index.d.ts",
        "import": "./dist/runtime/index.js"
      },
      "default": null
    },
    "./host": {
      "node": {
        "types": "./dist/host/index.d.ts",
        "import": "./dist/host/index.js"
      },
      "default": null
    },
    "./host/contracts": {
      "types": "./dist/host/contracts.d.ts",
      "import": "./dist/host/contracts.js"
    },
    "./history": {
      "types": "./dist/history/index.d.ts",
      "import": "./dist/history/index.js"
    },
    "./files": {
      "types": "./dist/files/index.d.ts",
      "import": "./dist/files/index.js"
    },
    "./files/node": {
      "node": {
        "types": "./dist/files/node.d.ts",
        "import": "./dist/files/node.js"
      },
      "default": null
    },
    "./storage/contracts": {
      "types": "./dist/storage/contracts.d.ts",
      "import": "./dist/storage/contracts.js"
    },
    "./runtime/contracts": {
      "types": "./dist/runtime/contracts.d.ts",
      "import": "./dist/runtime/contracts.js"
    },
    "./runtime/node-contracts": {
      "node": {
        "types": "./dist/runtime/node-contracts.d.ts",
        "import": "./dist/runtime/node-contracts.js"
      },
      "default": null
    },
    "./host/node-contracts": {
      "node": {
        "types": "./dist/host/node-contracts.d.ts",
        "import": "./dist/host/node-contracts.js"
      },
      "default": null
    },
    "./history/contracts": {
      "types": "./dist/history/contracts.d.ts",
      "import": "./dist/history/contracts.js"
    },
    "./files/contracts": {
      "types": "./dist/files/contracts.d.ts",
      "import": "./dist/files/contracts.js"
    },
    "./files/node-contracts": {
      "node": {
        "types": "./dist/files/node-contracts.d.ts",
        "import": "./dist/files/node-contracts.js"
      },
      "default": null
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "test": "tsx scripts/test.ts",
    "check:boundaries": "tsx scripts/boundaries.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:boundaries && npm run build && npm test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@trpc/server": "11.18.0",
    "cmd-ts": "0.15.0",
    "tsx": "4.23.15",
    "zod": "4.1.5"
  }
}
