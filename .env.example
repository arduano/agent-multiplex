# Applications read the process environment; they do not automatically load
# this file. Required values are blank and should be provisioned securely.

# Transport trust domain -----------------------------------------------------
# Shared by control nodes, runtime nodes, and access gateways in one trust
# domain. Use at least 32 random UTF-8 bytes.
AGENT_MULTIPLEX_SHARED_SECRET=

# Control node ---------------------------------------------------------------
AGENT_MULTIPLEX_CONTROL_NODE_STATE=.agent-multiplex/control-node.sqlite
# Defaults to <STATE>.identity. Back up both files; the identity is independently
# pinned by runtimes, child controls, and gateways.
# AGENT_MULTIPLEX_CONTROL_NODE_IDENTITY=.agent-multiplex/control-node.identity
# AGENT_MULTIPLEX_CONTROL_NODE_NAME=laptop-authority
# AGENT_MULTIPLEX_CONTROL_NODE_INSTANCE_ID=
AGENT_MULTIPLEX_CONTROL_NODE_HTTP_BIND=127.0.0.1
AGENT_MULTIPLEX_CONTROL_NODE_HTTP_PORT=4317
AGENT_MULTIPLEX_CONTROL_NODE_RUNTIME_STALE_MS=30000
AGENT_MULTIPLEX_CONTROL_NODE_CHILD_STALE_MS=30000
AGENT_MULTIPLEX_CONTROL_NODE_UPSTREAM_HEARTBEAT_MS=10000
AGENT_MULTIPLEX_CONTROL_NODE_RECONNECT_MAX_MS=30000

# Enrollment apertures are off by default. Open only the required role while
# bootstrapping trusted endpoints, then close it after enrollment is durable.
# AGENT_MULTIPLEX_CONTROL_NODE_ALLOW_RUNTIME_NODE_ENROLLMENT=1
# AGENT_MULTIPLEX_CONTROL_NODE_ALLOW_CHILD_CONTROL_NODE_ENROLLMENT=1
# AGENT_MULTIPLEX_CONTROL_NODE_ALLOW_ACCESS_GATEWAY_ENROLLMENT=1
# Gateway grants default to read-only even while enrollment is open. Terminal
# viewing and control are separate grants; terminal-control also permits view.
# AGENT_MULTIPLEX_CONTROL_NODE_ACCESS_GATEWAY_SCOPES='["read","agent-control","terminal-view","terminal-control","metadata-propose"]'

# A branch has exactly one desired parent. All three values must be supplied
# together on first bootstrap: logical identity, independently pinned endpoint,
# and an untrusted reachability locator. Durable desired state wins afterward.
# AGENT_MULTIPLEX_CONTROL_NODE_UPSTREAM_ID=
# AGENT_MULTIPLEX_CONTROL_NODE_UPSTREAM_ENDPOINT_ID=
# AGENT_MULTIPLEX_CONTROL_NODE_UPSTREAM_TICKET=

# Runtime node ---------------------------------------------------------------
# Copy these two distinct values from the control-node output. The endpoint ID
# is the trust anchor; the ticket is only a bootstrap/fallback locator.
AGENT_MULTIPLEX_CONTROL_NODE_ENDPOINT_ID=
AGENT_MULTIPLEX_CONTROL_NODE_TICKET=
AGENT_MULTIPLEX_RUNTIME_NODE_ALLOWED_ROOTS='["/absolute/path/to/projects"]'
AGENT_MULTIPLEX_RUNTIME_NODE_STATE_DIR=.agent-multiplex/runtime-node
# AGENT_MULTIPLEX_RUNTIME_NODE_NAME=build-machine-1
AGENT_MULTIPLEX_RUNTIME_NODE_HARNESSES=codex,copilot
AGENT_MULTIPLEX_RUNTIME_NODE_ADAPTER_MODE=native
AGENT_MULTIPLEX_RUNTIME_NODE_HEARTBEAT_MS=10000
AGENT_MULTIPLEX_RUNTIME_NODE_INVENTORY_REFRESH_MS=60000
AGENT_MULTIPLEX_RUNTIME_NODE_METADATA_FLUSH_MS=5000
AGENT_MULTIPLEX_RUNTIME_NODE_RECONNECT_MAX_MS=30000
# Managed PTYs, replay screens, and keyboard leases are memory-only. This is a
# process-wide limit across terminal-capable adapters.
AGENT_MULTIPLEX_RUNTIME_NODE_MAX_RUNNING_TERMINALS=32

# Test-only deterministic adapter. It exposes one Codex-shaped mock harness.
# AGENT_MULTIPLEX_RUNTIME_NODE_ADAPTER_MODE=mock
# AGENT_MULTIPLEX_RUNTIME_NODE_HARNESSES=codex
# AGENT_MULTIPLEX_RUNTIME_NODE_MOCK_STREAM_INTERVAL_MS=5
# AGENT_MULTIPLEX_RUNTIME_NODE_MOCK_CHUNK_COUNT=8

# Codex runtime adapter
# AGENT_MULTIPLEX_RUNTIME_NODE_CODEX_BINARY=codex
# AGENT_MULTIPLEX_RUNTIME_NODE_CODEX_ARGS='["app-server"]'
# AGENT_MULTIPLEX_RUNTIME_NODE_CODEX_SCOPE=codex:default
# The runtime supervises a private Unix-socket app server shared by structured
# proxy clients and managed `codex resume --remote` TUIs.

# Copilot runtime adapter
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_HOME=/absolute/path/to/copilot-home
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_SCOPE=copilot:default
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_LOG_LEVEL=warning
# Stock Copilot TUI support is experimental and off by default. It requires the
# exact CLI version 1.0.81 and always passes --no-auto-update. An incompatible
# or failed probe falls back to structured Copilot without a terminal.
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_EXPERIMENTAL_UI_SERVER=1
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_BINARY=/absolute/path/to/copilot

# Optional runtime-local Copilot BYOK provider. Setting any field requires
# BASE_URL and MODEL. For codex-lb use the OpenAI-compatible /v1 URL, Responses,
# and HTTP. Configure exactly one credential file; never place its content here.
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_PROVIDER_BASE_URL=http://codex-lb.internal/v1
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_PROVIDER_TYPE=openai
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_PROVIDER_WIRE_API=responses
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_PROVIDER_TRANSPORT=http
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_PROVIDER_MODEL=gpt-5.6-sol
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_PROVIDER_MODELS='["gpt-5.6-sol","gpt-5.6-terra"]'
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_PROVIDER_API_KEY_FILE=/run/secrets/codex-lb-api-key
# AGENT_MULTIPLEX_RUNTIME_NODE_COPILOT_PROVIDER_BEARER_TOKEN_FILE=/run/secrets/provider-bearer-token

# Access gateway -------------------------------------------------------------
# Required versioned JSON. Each source directly names a control node; a gateway
# cannot use another gateway as a source. requestedScopes defaults to ["read"].
AGENT_MULTIPLEX_ACCESS_GATEWAY_SOURCES=
AGENT_MULTIPLEX_ACCESS_GATEWAY_STATE=.agent-multiplex/access-gateway.sqlite
AGENT_MULTIPLEX_ACCESS_GATEWAY_IDENTITY=.agent-multiplex/access-gateway.identity
AGENT_MULTIPLEX_ACCESS_GATEWAY_HTTP_BIND=127.0.0.1
AGENT_MULTIPLEX_ACCESS_GATEWAY_HTTP_PORT=4318
AGENT_MULTIPLEX_ACCESS_GATEWAY_RECONNECT_MAX_MS=30000

# A non-loopback gateway requires bearer auth. Prefer a read-only token for
# viewers; action scopes grant permission to propose, never data authority.
# Include `terminal-view` for read-only PTY attachment, or `terminal-control`
# for open/lease/input/resize/termination. A normal UI also needs `read`.
# AGENT_MULTIPLEX_ACCESS_GATEWAY_BEARER_TOKEN_FILE=/run/secrets/gateway.token
# AGENT_MULTIPLEX_ACCESS_GATEWAY_SCOPES='["read"]'
# Full terminal operator example:
# AGENT_MULTIPLEX_ACCESS_GATEWAY_SCOPES='["read","agent-control","terminal-view","terminal-control","metadata-propose"]'
# AGENT_MULTIPLEX_ACCESS_GATEWAY_AUTH_SUBJECT=personal-dashboard
# AGENT_MULTIPLEX_ACCESS_GATEWAY_AUTH_FILE=/run/secrets/gateway-auth.json

# CLI ------------------------------------------------------------------------
AGENT_MULTIPLEX_HTTP_URL=http://127.0.0.1:4317/trpc
# AGENT_MULTIPLEX_WS_URL=ws://127.0.0.1:4317/trpc
# AGENT_MULTIPLEX_HTTP_HEADERS='{"x-example":"value"}'
# AGENT_MULTIPLEX_AUTH_TOKEN=replace-with-gateway-bearer-token
# AGENT_MULTIPLEX_DEBUG=1
